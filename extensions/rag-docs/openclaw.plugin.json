{
  "id": "rag-docs",
  "name": "RAG Documents (Gateway RPC)",
  "description": "Adds rag.* gateway methods used by the Documents dashboard page.",
  "version": "0.2.0",
  "configSchema": {
    "type": "object",
    "properties": {
      "ragBaseUrl": {
        "type": "string",
        "description": "RAG API base URL (e.g. http://localhost:8100)"
      },
      "ragToken": {
        "type": "string",
        "description": "Bearer token for the RAG API (determines tenant scope)"
      },
      "defaultTenant": {
        "type": "string",
        "description": "Optional tenant ID to pre-select in the dashboard"
      }
    },
    "required": ["ragBaseUrl", "ragToken"],
    "additionalProperties": false
  },
  "uiHints": {
    "ragBaseUrl": { "label": "RAG API URL", "placeholder": "http://localhost:8100" },
    "ragToken": { "label": "RAG Bearer Token", "sensitive": true },
    "defaultTenant": { "label": "Default Tenant", "help": "Auto-selected in the dashboard" }
  }
}
